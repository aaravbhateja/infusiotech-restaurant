{
  "buildCommand": "npx expo export -p web && node scripts/free-root.js",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/landing/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    },
    {
      "source": "/_expo/static/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ],
  "rewrites": [
    { "source": "/", "destination": "https://blinkrest-site.vercel.app/" },
    { "source": "/_next/:path*", "destination": "https://blinkrest-site.vercel.app/_next/:path*" },
    { "source": "/images/:path*", "destination": "https://blinkrest-site.vercel.app/images/:path*" },
    { "source": "/video/:path*", "destination": "https://blinkrest-site.vercel.app/video/:path*" },
    { "source": "/icon.png", "destination": "https://blinkrest-site.vercel.app/icon.png" },
    { "source": "/apple-icon.png", "destination": "https://blinkrest-site.vercel.app/apple-icon.png" },
    { "source": "/account-deletion", "destination": "/account-deletion.html" },
    { "source": "/accept-invite", "destination": "/accept-invite.html" },
    { "source": "/admin-login", "destination": "/admin-login.html" },
    { "source": "/admin/tenants/:id", "destination": "/admin/tenants/[id].html" },
    { "source": "/admin/support", "destination": "/admin/support.html" },
    { "source": "/admin/kyc", "destination": "/admin/kyc.html" },
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/analytics", "destination": "/analytics.html" },
    { "source": "/cashier-home", "destination": "/cashier-home.html" },
    { "source": "/customers/:id", "destination": "/customers/[id].html" },
    { "source": "/customers", "destination": "/customers/index.html" },
    { "source": "/home", "destination": "/home.html" },
    { "source": "/kitchen-home", "destination": "/kitchen-home.html" },
    { "source": "/login", "destination": "/login.html" },
    { "source": "/manager-home", "destination": "/manager-home.html" },
    { "source": "/menu/new", "destination": "/menu/new.html" },
    { "source": "/menu/:id", "destination": "/menu/[id].html" },
    { "source": "/menu", "destination": "/menu/index.html" },
    { "source": "/more", "destination": "/more.html" },
    { "source": "/notifications", "destination": "/notifications.html" },
    { "source": "/offers/create", "destination": "/offers/create.html" },
    { "source": "/offers", "destination": "/offers/index.html" },
    { "source": "/onboarding", "destination": "/onboarding.html" },
    { "source": "/forgot-password", "destination": "/forgot-password.html" },
    { "source": "/reset-password", "destination": "/reset-password.html" },
    { "source": "/order/:token", "destination": "/order/[token].html" },
    { "source": "/orders/new", "destination": "/orders/new.html" },
    { "source": "/orders/:id", "destination": "/orders/[id].html" },
    { "source": "/orders", "destination": "/orders.html" },
    { "source": "/otp", "destination": "/otp.html" },
    { "source": "/payments/:id", "destination": "/payments/[id].html" },
    { "source": "/payments", "destination": "/payments/index.html" },
    { "source": "/r/:slug/:table", "destination": "/r/[slug]/[table].html" },
    { "source": "/preview/menu", "destination": "/preview/menu.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/reviews", "destination": "/reviews.html" },
    { "source": "/settings/branding", "destination": "/settings/branding.html" },
    { "source": "/settings/payments-kyc", "destination": "/settings/payments-kyc.html" },
    { "source": "/settings/delete-account", "destination": "/settings/delete-account.html" },
    { "source": "/settings/profile", "destination": "/settings/profile.html" },
    { "source": "/settings/orders", "destination": "/settings/orders.html" },
    { "source": "/settings/security", "destination": "/settings/security.html" },
    { "source": "/settings", "destination": "/settings.html" },
    { "source": "/staff/invite", "destination": "/staff/invite.html" },
    { "source": "/staff/permissions", "destination": "/staff/permissions.html" },
    { "source": "/staff/roles", "destination": "/staff/roles.html" },
    { "source": "/staff", "destination": "/staff/index.html" },
    { "source": "/subscription", "destination": "/subscription.html" },
    { "source": "/support", "destination": "/support.html" },
    { "source": "/table/:id", "destination": "/table/[id].html" },
    { "source": "/tables", "destination": "/tables.html" },
    { "source": "/waiter-home", "destination": "/waiter-home.html" },
    { "source": "/welcome", "destination": "/welcome.html" },
    { "source": "/select-restaurant", "destination": "/select-restaurant.html" }
  ]
}
